---
import MainGridLayout from "@layouts/MainGridLayout.astro";
---
<MainGridLayout title="页面未找到">
  <section class="card-base rounded-[var(--radius-large)] p-8 md:p-12 text-center">
    <div class="font-bold text-7xl text-[var(--primary)] mb-6">404</div>
    <h1 class="font-bold text-2xl mb-4">这个页面暂时不存在</h1>
    <p class="text-75 mb-8">你可以返回首页，或者通过搜索寻找对应的文章与笔记。</p>
    <a href="/" class="px-6 py-3 rounded-xl bg-[var(--primary)] text-white font-medium">返回首页 ↗</a>
  </section>
</MainGridLayout>
