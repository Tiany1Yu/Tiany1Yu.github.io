---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PostPage from "@components/PostPage.astro";
import { getSortedPosts } from "@utils/content-utils";
const articles = (await getSortedPosts()).filter(entry => entry.slug.startsWith("writing/"));
---
<MainGridLayout title="文章" description="文章">
  <header class="px-2 py-2 mb-5 onload-animation">
    <h1 class="text-2xl md:text-3xl font-bold text-90">文章</h1>
  </header>
  <PostPage page={{data: articles}} />
</MainGridLayout>
